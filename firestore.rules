rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.active == true;
    }

    function role() {
      return request.auth.token.role;
    }

    function isOwner() {
      return signedIn() && role() == "owner";
    }

    function isAdmin() {
      return signedIn()
        && (role() == "owner" || role() == "admin");
    }

    function isManager() {
      return signedIn()
        && (
          role() == "owner"
          || role() == "admin"
          || role() == "manager"
        );
    }

    function canCreateTransaction() {
      return signedIn()
        && (
          role() == "owner"
          || role() == "admin"
          || role() == "manager"
          || role() == "employee"
        );
    }

    match /rp_transactions/{recordId} {
      allow read: if signedIn();

      allow create: if canCreateTransaction()
        && request.resource.data.createdBy.uid == request.auth.uid;

      allow update: if isManager()
        && request.resource.data.updatedBy.uid == request.auth.uid;

      allow delete: if isAdmin();
    }

    match /app_settings/{settingId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /access_users/{discordId} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner();
    }

    match /active_sessions/{sessionId} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && sessionId == request.auth.uid
        && request.resource.data.uid == request.auth.uid;

      allow delete: if signedIn()
        && sessionId == request.auth.uid;
    }
  }
}
